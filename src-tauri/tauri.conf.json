{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KobitoBar",
  "version": "0.1.0",
  "identifier": "com.esp9.kobitobar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "KobitoBar",
        "width": 324,
        "height": 384,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "keymap",
        "title": "KobitoKey キーマップ",
        "url": "index.html?view=keymap",
        "width": 920,
        "height": 580,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/keymaps/": "keymaps/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
